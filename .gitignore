.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Build artifacts
dist/
build/
*.egg-info/

# Pytest cache
.pytest_cache/
.coverage
htmlcov/

# Temporary files
*.tmp
*.bak
